{
  "name": "dsh-plugin-<slug>",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "<One sentence, sentence case, describing what the user gets.>",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --test test/*.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
